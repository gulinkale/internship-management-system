@model StajTakipUygulaması.Domain.Entities.Basvuru

@{
    ViewBag.Title = "Başvuruyu Onayla";
}

<div class="container mt-4">
    <h3 class="mb-4">Başvuruyu Onayla</h3>

    <form asp-action="KabulEt" asp-route-id="@Model.ID" method="post">
        @Html.AntiForgeryToken()

        <!-- Yetkiler -->
        <div class="mb-3">
            <label asp-for="Yetkiler" class="form-label">Yetkiler</label>
            <input asp-for="Yetkiler" class="form-control" rows="3" />
            <span asp-validation-for="Yetkiler" class="text-danger"></span>
        </div>

        <!-- Departman -->
        <div class="mb-3">
            <label asp-for="Departman" class="form-label">Departman</label>
            <input asp-for="Departman" class="form-control" />
            <span asp-validation-for="Departman" class="text-danger"></span>
        </div>

        <!-- Sorumlu ID -->
        <div class="mb-3">
            <label asp-for="SorumluID" class="form-label">Sorumlu ID</label>
            <input asp-for="SorumluID" class="form-control" />
            <span asp-validation-for="SorumluID" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">Onayla</button>
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
